{
  "name": "ciadi-dashboard-windows",
  "version": "1.0.1",
  "description": "Aplicação Windows CIADI com atalhos por módulo e seleção de polo",
  "main": "main.cjs",
  "author": "CIADI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ao.ciadi.dashboard",
    "productName": "CIADI Dashboard",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "node_modules/electron-updater/**/*",
      "biometric-k20pro.html",
      "build/installer.nsh"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ivanioalberto83-cmyk",
        "repo": "CIADI-"
      }
    ],
    "win": {
      "icon": "ciadi.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CIADI-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "ciadi.ico",
      "uninstallerIcon": "ciadi.ico",
      "installerHeaderIcon": "ciadi.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "CIADI Dashboard",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "runAfterFinish": false
    }
  }
}
